  </PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Antlr4.Runtime.Standard" Version="4.13.1" />
		<PackageReference Include="Antlr4BuildTasks" Version="12.8" PrivateAssets="all" />

		<Antlr4 Include="Grammar\SpreadsheetExpression.g4">
