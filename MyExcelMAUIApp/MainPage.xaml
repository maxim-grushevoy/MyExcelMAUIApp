<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:MyExcelMAUIApp"
             x:Class="MyExcelMAUIApp.MainPage">

  <ContentPage.Resources>
    <Style TargetType="Button">
      <Setter Property="Margin" Value="2" />
    </Style>
  </ContentPage.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- файл, обчислення, режим -->
    <FlexLayout Grid.Row="0" Wrap="Wrap">
      <Button Text="Зберегти" Clicked="SaveButton_Clicked" />
      <Button Text="Зберегти як" Clicked="SaveAsButton_Clicked" />
      <Button Text="Прочитати" Clicked="ReadButton_Clicked" />
      <Button Text="Порахувати" Clicked="CalculateButton_Clicked" />
      <Button x:Name="modeButton" Text="Режим: ВИРАЗ" Clicked="ModeButton_Clicked" />
      <Button Text="Довідка" Clicked="HelpButton_Clicked" />
      <Button Text="Про програму" Clicked="AboutButton_Clicked" />
      <Button Text="Вийти" Clicked="ExitButton_Clicked" />
    </FlexLayout>

    <!-- рядки і стовпчики -->
    <FlexLayout Grid.Row="1" Wrap="Wrap" AlignItems="Center">
      <Button Text="＋ Рядок у кінець" Clicked="AddRowButton_Clicked" />
      <Button Text="＋ Стовпчик у кінець" Clicked="AddColumnButton_Clicked" />
      <Label Margin="10,0,0,0" VerticalOptions="Center"
             Text="Щоб додати в потрібне місце, видалити або змінити розмір — натисніть на номер рядка чи літеру стовпчика." />
    </FlexLayout>

    <!-- рядок стану: адреса клітинки, вираз або повідомлення про помилку -->
    <Label x:Name="statusLabel" Grid.Row="2" Margin="6,2" Text="Готово" />

    <ScrollView Grid.Row="3" Orientation="Both">
      <Grid x:Name="grid">
      </Grid>
    </ScrollView>
  </Grid>
</ContentPage>
